# API Keys and Credentials Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED API KEYS =====

# Anthropic API (for Claude AI script generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (for Text-to-Speech)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud OAuth (for Google Drive & Gmail)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===== OPTIONAL API KEYS =====

# SerpAPI (for enhanced web search - has free tier)
# Get it at: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# ===== CONFIGURATION =====

# Email Configuration
NOTIFICATION_EMAIL=your-email@example.com

# Podcast Personalization
PODCAST_HOST_NAME=Saif
PODCAST_DURATION_MINUTES=19
PODCAST_LANGUAGE=de

# Workflow Settings
TRIGGER_TIME=08:05
TIMEZONE=Europe/Berlin
